{
  admin off
  auto_https off
}

:8080 {
  header {
    Access-Control-Allow-Origin https://rocksymiguel.github.io
    Vary Origin
    Cache-Control "no-store"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }

  # Deny writes before selecting a route. Never proxy the LAN site's root.
  @write not method GET
  handle @write {
    header Allow "GET"
    respond "Public API is read-only" 405
  }
  @environment path /api/environment/health /api/environment/weather /api/environment/station /api/environment/tides
  handle @environment {
    request_body {
      max_size 1KB
    }
    reverse_proxy bcbd-environment:8001 {
      header_up -Cookie
      header_up -Authorization
      transport http {
        dial_timeout 5s
        response_header_timeout 60s
      }
    }
  }
  handle {
    respond "Not found" 404
  }
}
